 wire [15:0] CR, MUL, selected;
 wire MA;
 // Registers
 Register #(8) regX(.clk(clk), .rst(rst), .load(1'b1), .d(X), .q(regX_out));
 Register #(8) regY(.clk(clk), .rst(rst), .load(1'b1), .d(Y), .q(regY_out));
