// Module: AWM3 (Approximate Multiplier)
// ===============================================================
module AWM3 (
 input wire [7:0] a, b,
 output wire [15:0] product
);
 localparam integer APP_BITS = 9;
 wire [15:0] pp [7:0];
 genvar i;
 generate
 for (i = 0; i < 8; i = i + 1) begin : gen_pp
 assign pp[i] = {8'b0, (a & {8{b[i]}})} << i;
 end
 endgenerate
 wire [15:0] s1, s2, s3, s4, s5, s6, s7;
 stage_adder_dafa3 #(.APP_BITS(APP_BITS)) add1 (.a(pp[0]), .b(pp[1]), .sum(s1));
 stage_adder_dafa3 #(.APP_BITS(APP_BITS)) add2 (.a(s1), .b(pp[2]), .sum(s2));
 stage_adder_dafa3 #(.APP_BITS(APP_BITS)) add3 (.a(s2), .b(pp[3]), .sum(s3));
 stage_adder_dafa3 #(.APP_BITS(APP_BITS)) add4 (.a(s3), .b(pp[4]), .sum(s4));
 stage_adder_dafa3 #(.APP_BITS(APP_BITS)) add5 (.a(s4), .b(pp[5]), .sum(s5));
