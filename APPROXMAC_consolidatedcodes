module ResultSelector (
 input [15:0] CR,
 input [15:0] MUL,
 input MA,
 output [15:0] selected
);
 assign selected = (MA) ? CR : MUL;
endmodule
// ===============================================================
// Module: stage_adder_dafa3
// ===============================================================
module stage_adder_dafa3 #(parameter APP_BITS = 9)(
 input wire [15:0] a, b,
 output wire [15:0] sum
);
 wire [15:0] carry;
 assign carry[0] = 1'b0;
 genvar i;
 generate
 for (i = 0; i < 16; i = i + 1) begin : loop
 wire s, c;
 if (i < APP_BITS)
 fa_dafa3 fa(.a(a[i]), .b(b[i]), .cin(carry[i]), .sum(s), .cout(c));
 else
 fa_exact fa(.a(a[i]), .b(b[i]), .cin(carry[i]), .sum(s), .cout(c));
 assign sum[i] = s;
 if (i < 15) assign carry[i + 1] = c;
 end
 endgenerate
endmodule
