module Register #(parameter WIDTH = 8)(
 input clk,
 input rst,
 input load,
 input [WIDTH-1:0] d,
 output reg [WIDTH-1:0] q
);
 always @(posedge clk or posedge rst) begin
 if (rst)
 q <= 0;
 else if (load)
 q <= d;
 end
endmodule
