// ===============================================================
// Module: fa_dafa3 (Approximate Full Adder)
// ===============================================================
module fa_dafa3(
 input wire a, b, cin,
 output wire sum, cout
);
 wire axorb = (a & ~b) | (~a & b);
 wire parity = (axorb & ~cin) | ((~axorb) & cin);
 wire all_ones = a & b & cin;
 assign sum = parity & ~all_ones;
 assign cout = (a & b) | (b & cin) | (a & cin); // exact carry
endmodule
// ===============================================================
// Module: fa_exact (Exact Full Adder)
// ===============================================================
module fa_exact(
 input wire a, b, cin,
 output wire sum, cout
);
 assign sum = a ^ b ^ cin;
 assign cout = (a & b) | (b & cin) | (a & cin);
endmodule